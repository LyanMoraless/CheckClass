# Base URL the app uses to reach the CheckClass backend (NestJS, see backend/README.md).
#
# - iOS simulator: the host machine's localhost is reachable directly.
# - Android emulator: localhost refers to the emulator itself, not the host machine —
#   use 10.0.2.2 instead (the emulator's alias for the host loopback interface).
# - Physical device on the same network: use the host machine's LAN IP.
#
# Expo exposes any EXPO_PUBLIC_* variable to app code via process.env at build time
# (see src/lib/env.ts) — copy this file to .env and adjust per platform/environment.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Talsec freeRASP (src/lib/mobile-security-signals.ts) — camada 2 of the anti-spoofing
# design approved for RULE-PRES-01/09 ("Decisão de tecnologia — Detecção de localização
# simulada e dispositivo comprometido, App Mobile", architecture-overview.md). These are
# real per-organization secrets from a Talsec account (https://docs.talsec.app) — nobody
# has provisioned one for this project yet (see the Mobile Implementation Summary's
# "Flagged issues"). Left unset, freeRASP simply never starts (device-compromise/
# GPS-spoofing detection degrades to expo-location's own `mocked` field only) — the app
# does not crash or block check-in either way.
# EXPO_PUBLIC_FREERASP_WATCHER_MAIL=security@your-institution.example
# EXPO_PUBLIC_FREERASP_ANDROID_CERT_HASHES=base64-sha256-hash-1,base64-sha256-hash-2
# EXPO_PUBLIC_FREERASP_IOS_TEAM_ID=YOUR_APPLE_TEAM_ID
