{
  "name": "checkclass-backend",
  "version": "0.1.0",
  "description": "CheckClass backend - multifactor attendance core",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:generate": "npm run typeorm -- migration:generate",
    "device:create": "ts-node -r tsconfig-paths/register src/scripts/create-device.ts",
    "config:set": "ts-node -r tsconfig-paths/register src/scripts/config-set.ts",
    "session:create": "ts-node -r tsconfig-paths/register src/scripts/session-create.ts",
    "session:evaluate": "ts-node -r tsconfig-paths/register src/scripts/session-evaluate.ts",
    "pending:resolve": "ts-node -r tsconfig-paths/register src/scripts/pending-resolve.ts",
    "register:query": "ts-node -r tsconfig-paths/register src/scripts/register-query.ts",
    "tenant:create": "ts-node -r tsconfig-paths/register src/scripts/tenant-create.ts",
    "login:test": "ts-node -r tsconfig-paths/register src/scripts/login-test.ts",
    "group:manage": "ts-node -r tsconfig-paths/register src/scripts/group-manage.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "pg-boss": "^12.27.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
