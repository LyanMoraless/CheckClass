PORT=3000

# Superuser connection, used only to run migrations (DDL, RLS policies, role creation).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=checkclass
DB_PASSWORD=checkclass
DB_DATABASE=checkclass

# Unprivileged application role the backend actually connects as at runtime.
# Must NOT be a superuser and must NOT have BYPASSRLS, or RLS-based tenant
# isolation (RULE-TEN-01) is silently bypassed. Created by the InitSchema migration.
APP_DB_USERNAME=checkclass_app
APP_DB_PASSWORD=checkclass_app

# Signs/verifies session JWTs issued by POST /v1/auth/login. Generate a real
# random value for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-value-in-every-real-environment

# Frontend origin(s) allowed to call this API from a browser, comma-separated.
CORS_ORIGIN=http://localhost:5173

# Frente 07 — absence-justification attachments (RULE-JUST-09/11/19). Object
# storage gerenciado, compatível com S3 (category approved 2026-09-08);
# concrete provider intentionally left open -- point these at any
# S3-compatible endpoint. Example below targets a local MinIO for dev.
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=checkclass-absence-justification-attachments
STORAGE_S3_ACCESS_KEY_ID=change-me
STORAGE_S3_SECRET_ACCESS_KEY=change-me
STORAGE_S3_FORCE_PATH_STYLE=true
# Optional; unset relies on the bucket's own default-encryption
# configuration (RULE-JUST-11.6) instead of a per-object SSE header.
# STORAGE_S3_SSE_ALGORITHM=aws:kms
