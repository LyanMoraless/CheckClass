PORT=3000

# Superuser connection, used only to run migrations (DDL, RLS policies, role creation).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=checkclass
DB_PASSWORD=checkclass
DB_DATABASE=checkclass

# Unprivileged application role the backend actually connects as at runtime.
# Must NOT be a superuser and must NOT have BYPASSRLS, or RLS-based tenant
# isolation (RULE-TEN-01) is silently bypassed. Created by the InitSchema migration.
APP_DB_USERNAME=checkclass_app
APP_DB_PASSWORD=checkclass_app

# Signs/verifies session JWTs issued by POST /v1/auth/login. Generate a real
# random value for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-value-in-every-real-environment

# Frontend origin(s) allowed to call this API from a browser, comma-separated.
CORS_ORIGIN=http://localhost:5173
